        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    CUSTOMER ||--o{ ADDRESS : has\n    CUSTOMER ||--o{ ORDERS : places\n    RESTAURANT ||--o{ MENU_ITEM : offers\n    RESTAURANT ||--o{ ORDERS : receives\n    ADDRESS ||--o{ ORDERS : \&quot;is used for\&quot;\n    ORDERS ||--o{ ORDER_ITEM : contains\n    MENU_ITEM ||--o{ ORDER_ITEM : \&quot;appears in\&quot;\n    ORDERS ||--|| PAYMENT : has\n    DELIVERY_PARTNER ||--o{ DELIVERY : handles\n    ORDERS ||--|| DELIVERY : has\n\n    CUSTOMER {\n        INT customer_id PK\n        VARCHAR full_name\n        VARCHAR email\n        VARCHAR phone\n    }\n\n    ADDRESS {\n        INT address_id PK\n        INT customer_id FK\n        VARCHAR address_line\n        VARCHAR city\n        VARCHAR postal_code\n    }\n\n    RESTAURANT {\n        INT restaurant_id PK\n        VARCHAR restaurant_name\n        VARCHAR phone\n        VARCHAR address\n        VARCHAR status\n    }\n\n    MENU_ITEM {\n        INT item_id PK\n        INT restaurant_id FK\n        VARCHAR item_name\n        DECIMAL price\n        VARCHAR category\n    }\n\n    ORDERS {\n        INT order_id PK\n        INT customer_id FK\n        INT restaurant_id FK\n        INT address_id FK\n        DATETIME order_date\n        VARCHAR order_status\n        DECIMAL total_amount\n    }\n\n    ORDER_ITEM {\n        INT order_item_id PK\n        INT order_id FK\n        INT item_id FK\n        INT quantity\n        DECIMAL unit_price\n    }\n\n    PAYMENT {\n        INT payment_id PK\n        INT order_id FK\n        VARCHAR payment_method\n        VARCHAR payment_status\n        VARCHAR transaction_id\n    }\n\n    DELIVERY_PARTNER {\n        INT partner_id PK\n        VARCHAR partner_name\n        VARCHAR phone\n        VARCHAR vehicle_type\n        VARCHAR status\n    }\n\n    DELIVERY {\n        INT delivery_id PK\n        INT order_id FK\n        INT partner_id FK\n        DATETIME assigned_at\n        DATETIME delivered_at\n        VARCHAR delivery_status\n    }\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9rt3G18oQjTQe_3T3PON-178">
